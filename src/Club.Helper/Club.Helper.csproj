<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- 1.4: IQN инициатора и мастер-том (суперклиент), состав версии, Secure Boot, системный диск, DHCP.
         1.4.1: IQN — отдельным коротким опросом со следующего такта (регистрация и отчёты первого такта его не ждут),
         перед ним служба MSiSCSI запускается (ожидание до 10 с); пустой IQN перечитывается не чаще раза за такт с паузой
         до 10 мин; таймаут PowerShell — TimeoutException, не отмена.
         1.4.2: отказ Windows отключить старую версию (том занят: игра, Steam, открытые файлы) — switchPending со старой
         версией в отчёте и повтор в следующем такте, а не сбой такта; в причине — первая строка отказа Windows, таймаут
         PowerShell — «timeout», а не «открытые файлы»; сбой применения тома или мастер-тома не отменяет отчёт (failed с
         причиной; после таймаута сессии заново не опрашиваются; мастер-том, о котором ничего не известно, — unknown,
         сервер прежнее состояние не сбрасывает); сбой проверки старой версии не мешает проверке текущей. Процесс с тома
         ищется и по пути NT (QueryDosDevice + PROCESS_NAME_NATIVE): на стенде 1.4.1 по пути Win32 не нашла запущенные с G:
         игру и Steam; при отказе Windows без найденного процесса — одно предупреждение с диагностикой процессов и тем, что
         вернул поиск диска таргета (без буквы — проход по запомненной или назначенной букве); процесс нашёлся не по пути
         Win32 под буквой — одно предупреждение на причину с обеими формами пути. Таймаут PowerShell при проверке
         подключённой версии её не отключает (failed, сессия остаётся; диск на запись — fail-closed), таймаут на старой
         версии пропускает проверку текущей в этом такте, после таймаута на томе мастер-том в такте не опрашивается
         (unknown); при сбое мастер-тома отчёт опирается на последний известный ответ, а не на unknown.
         1.5.0: личный диск игр места (сервер с Library:PersonalGames): таргет games-seat-NN подключается на запись с CHAP
         места (read-only не проверяется, любое другое назначение на запись по-прежнему отклоняется); при старте помощник
         сообщает серверу, подключён ли этот диск на ПК (attached), — сервер сбрасывает его и при висящей сессии прошлой
         загрузки. Личный диск берётся только из ответа на запрос при старте (со сбросом), пустой ответ его не отнимает,
         сохранённый без сброса — только если сервер недоступен дольше 3 минут; восстанавливающая связь сессия считается
         подключённой; быстрый запуск Windows выключается. Токены и сохранённое назначение привязаны к HWID (эталон
         бездиска приносит токены ПК мастера); при заглушке SMBIOS UUID в HWID — наименьший MAC физических карт. -->
    <Version>1.5.0</Version>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Сборка на Linux (CI, разработка); запуск — только на Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>ClubDisklessHelper</AssemblyName>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.EventLog" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Club.Helper.Core\Club.Helper.Core.csproj" />
  </ItemGroup>
</Project>
