# Настройки сервера клуба: /etc/club-server/club-server.env (права 640, владелец root:clubsrv).
# Секреты (токен панели, ключ клуба, API-ключ TrueNAS) — только здесь.

# --- адреса: HTTP нужен iPXE/WinPE (перезаливка), HTTPS — панели и помощнику ---
Kestrel__Endpoints__Http__Url=http://0.0.0.0:5080
Kestrel__Endpoints__Https__Url=https://0.0.0.0:5443
Kestrel__Endpoints__Https__Certificate__Path=/etc/club-server/tls/server.crt
Kestrel__Endpoints__Https__Certificate__KeyPath=/etc/club-server/tls/server.key

# --- база (peer-аутентификация: служба работает от пользователя clubsrv) ---
ConnectionStrings__Club=Host=/var/run/postgresql;Database=club;Username=clubsrv

# --- доступ ---
# openssl rand -hex 24
Panel__AdminToken=ЗАМЕНИТЬ
# openssl rand -hex 16 — тот же ключ пишется в helper.json на ПК
Auth__ClubApiKey=ЗАМЕНИТЬ
Auth__SigningKeyPath=/var/lib/club-server/jwt-signing-key.pem
Auth__AutoApprovePcs=false

# --- TrueNAS (этап 4, docs/install/stand.md) ---
TrueNas__Host=192.168.77.3
TrueNas__Port=443
TrueNas__Username=clubsrv
TrueNas__ApiKey=ЗАМЕНИТЬ
TrueNas__CaCertificatePath=/etc/club-server/tls/club-ca.crt

# --- библиотека игр (этап 4; до этого false) ---
Library__Enabled=false
Library__MasterZvol=tank/club/lib
Library__PublishedParent=tank/club/published
Library__PortalId=1
Library__InitiatorGroupId=1
Library__PortalAddress=192.168.77.3:3260
Library__DriveLetter=G

# --- Kea DHCP (этап 7; до этого false) ---
Kea__Enabled=false
Kea__ConnectionString=Host=/var/run/postgresql;Database=kea;Username=clubsrv

# --- образы Windows и PXE (позже) ---
Imaging__Enabled=false
Imaging__Root=/srv/club/images
Imaging__PxeRoot=/srv/club/pxe
Imaging__TftpRoot=/srv/tftp
Imaging__PublicBaseUrl=http://192.168.77.2:5080
